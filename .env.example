# Salin file ini menjadi .env.local (untuk pengembangan lokal), atau isi
# nilainya di Vercel → Project → Settings → Environment Variables.

# ——— Panel admin (/admin) ———
# Password bersama untuk pengurus gereja. Wajib diisi agar panel aktif.
ADMIN_PASSWORD=

# Opsional: secret terpisah untuk tanda tangan cookie sesi.
# Bila kosong, diturunkan dari ADMIN_PASSWORD.
ADMIN_SECRET=

# ——— Supabase (penyimpanan konten) ———
# Dari Supabase → Project Settings → API.
# Bila dikosongkan, website tetap jalan dengan konten statis bawaan,
# tetapi fitur pengelolaan konten di panel admin belum aktif.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
